# JobHunter Test Environment OAuth Configuration
#
# IMPORTANT: This is a TEMPLATE. Copy this file to .env.test and fill in actual values.
#
# Setup Instructions:
# 1. Copy this file: cp .env.test.example .env.test
# 2. Run: ./helper-scripts/setup-test-oauth.sh
# 3. The setup script will populate your .env.test with real tokens
#
# Security Note:
# - .env.test is in .gitignore (NEVER commit it to git)
# - Contains sensitive OAuth tokens for test automation
# - Refresh tokens enable auto-refresh of access tokens during preflight

# ============================================================================
# Gmail OAuth Configuration
# ============================================================================

# Access token (expires every 1 hour, auto-refreshed by preflight)
GMAIL_TEST_ACCESS_TOKEN=

# Refresh token (never expires unless unused for 6 months)
GMAIL_TEST_REFRESH_TOKEN=

# OAuth App credentials (from Google Cloud Console)
GMAIL_TEST_CLIENT_ID=
GMAIL_TEST_CLIENT_SECRET=

# ============================================================================
# Microsoft Mail OAuth Configuration
# ============================================================================

# Access token (expires every 1 hour, auto-refreshed by preflight)
MSMAIL_TEST_ACCESS_TOKEN=

# Refresh token (expires after 90 days, requires re-authorization)
MSMAIL_TEST_REFRESH_TOKEN=

# Azure AD App credentials (from Azure Portal)
MSMAIL_TEST_CLIENT_ID=
MSMAIL_TEST_CLIENT_SECRET=
MSMAIL_TEST_TENANT_ID=

# ============================================================================
# Token Maintenance Schedule
# ============================================================================
#
# Gmail:
#   - Access token: Auto-refreshed every test run (~2-4 sec if expired)
#   - Refresh token: Valid for years (truly one-time setup)
#   - Re-authorization: Only if unused for 6+ months or manually revoked
#
# Microsoft Mail:
#   - Access token: Auto-refreshed every test run (~2-4 sec if expired)
#   - Refresh token: Valid for 90 days
#   - Re-authorization: Run setup-test-oauth.sh quarterly (every ~90 days)
#
# ============================================================================
