# JobHunter Backend Environment Variables
# Copy this file to .env and update with your settings

# Database connection string
# For development with test data: jobhunter_dev
# For personal use: jobhunter_personal
DATABASE_URL=postgresql://jobhunter_user:jobhunter_dev_password@localhost/jobhunter_dev

# Rust logging level (trace, debug, info, warn, error)
RUST_LOG=info
