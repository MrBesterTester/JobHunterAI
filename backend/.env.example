# JobHunter Backend Environment Variables
# Copy this file to .env and update with your settings

# Database connection string
# For development with test data: jobhunter_dev
# For personal use: jobhunter_personal
DATABASE_URL=postgresql://jobhunter_user:jobhunter_dev_password@localhost/jobhunter_dev

# Rust logging level (trace, debug, info, warn, error)
RUST_LOG=info

# Gmail OAuth credentials (required for Gmail integration)
# Get these from: https://console.cloud.google.com/apis/credentials
# See README.md "Gmail Integration Setup" section for detailed instructions
GMAIL_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret-here
GMAIL_REDIRECT_URI=http://localhost:8080/auth/gmail/callback

# RapidAPI configuration (required for Indeed/job board integration)
# Get API key from: https://rapidapi.com
# Free tier: 500 requests/month
# See docs/PHASE_4.1_job-board-rapidAPI.md for setup instructions
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST_INDEED=job-search15.p.rapidapi.com

# Job search defaults (can override in database configuration)
JOB_SEARCH_LOCATION="Fremont, CA"
JOB_SEARCH_RADIUS=45
JOB_SEARCH_KEYWORDS="Software Test Engineer OR QA Engineer OR Test Automation"

# Anthropic API key (required for LLM job extraction)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
