{
  "name": "jobhunter-frontend",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:8080",
  "dependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.4",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@rsbuild/core": "^1.5.17",
    "@rsbuild/plugin-react": "^1.4.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.0",
    "@types/supertest": "^2.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^22.1.0",
    "msw": "^1.2.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.0"
  },
  "scripts": {
    "start": "rsbuild dev",
    "build": "npm run typecheck && rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:e2e": "tsc --project e2e/tsconfig.json --noEmit",
    "test": "npm run typecheck && jest --watchAll=false",
    "test:comprehensive": "ts-node ../src/test-orchestrator/main.ts",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:ci": "CI=true playwright test",
    "test:e2e:integration": "RUN_LLM_INTEGRATION_TESTS=true playwright test 04-content-generation",
    "test:e2e:integration-only": "RUN_LLM_INTEGRATION_TESTS=true playwright test 04-content-generation-integration"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
